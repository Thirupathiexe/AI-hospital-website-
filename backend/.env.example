# Copy to backend/.env and fill in. Never commit the real .env.
# Long random string; generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Turns on the AI (Claude) voice assistant. Without it, the basic built-in assistant is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional shared codes for Staff / Doctor login (leave empty for the brief's no-password login)
STAFF_ACCESS_CODE=
DOCTOR_ACCESS_CODE=
# Set true when served over HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Fixed clock for demos/tests, e.g. 2026-11-02 10:00
CLINIC_NOW=
